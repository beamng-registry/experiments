{
"citybus": {
    "information":{
        "authors":"BeamNG",
        "name":"Wentward Bus"
    },
    "slotType" : "main",

    "scaledragCoef":1,

    "slots": [
        ["type", "default", "description"],
        ["citybus_frame","citybus_frame","Frame", {"coreSlot":true}],
        ["paint_design","","Paint Design"],
        ["licenseplate_design_2_1","","License Plate Design"],
        ["citybus_mod", "", "Additional Modification"],
        ["skin_signtype","citybus_skin_signtype_flipdot","Destination Signs Type", {"coreSlot":true}]
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$brakestrength", "range", "", "Brakes", 1, 0.6, 1.0, "Brake Force Multiplier", "Scales the overall brake torque for this setup", {"minDis":60, "maxDis":100}],
        ["$ffbstrength", "range", "", "Chassis", 1, 0.5, 1.5, "Setup-Specific Force Feedback Multiplier", "Scales the force feedback strength for THIS SETUP ONLY", {"minDis":50, "maxDis":150}],
    ],
    "controller": [
        ["fileName"],
        ["vehicleController"],
        ["bus", {"nextStopNode":"nextstop", "destinationSignNode":"destsign"}],
        ["reverseWarn", {"beepLoopName":"event:>Vehicle>Electrics>Reverse>Beep_04"}],
        ["pneumatics/actuators", {"name":"airbags"}],
        ["pneumatics/actuators", {"name":"doors"}],
        ["pneumatics/autoLevelSuspension", {"name":"airSuspension"}],
        ["pneumatics/crossFlowValve", {"name": "auxTankCrossFlow"}],
    ],
    "airSuspension": {
        "actuationStartDistance": 0.005,
        "actuationEndDistance": 0.03,
        "actuationDelay": 3,
        "actuatorGroups": "airSuspensionData",
    },
    "airSuspensionData": [
        ["beamGroup", "controlBeamName", "controlGroupName"],
        ["leftAxle", "airbag_FL", "leftAxle"],
        ["rightAxle", "airbag_FR", "rightAxle"],
    ],
    "auxTankCrossFlow": {
        "sourceTankName": "mainAirTank",
        "targetTankName": "auxAirTank",
        "flowPipeRadius": 0.0075,
        "sourceTankMinPressurePSI": 60,
        "pressureDiffForFullFlowPSI": 5,
    },
    "airbags": {
        "airTankName": "auxAirTank",
        "supplyHoseRadius": 0.015,
        "pressureDumpFlowRate": 0.008,
        "maxSupplyPressurePSI": 90,
        "crossFlowBetweenBeams": true,
        "pressuredBeams": "airbagBeamData",
        "crossFlowGroups": "airbagCrossFlow",
        "groupSounds": "airbagBeamSoundData",
    },
    "airbagBeamData": [
        ["beamName", "groupName"],
        {"crossFlowTag": "common"},
    ],
    "airbagCrossFlow": [
        ["crossFlowTag", "virtualBufferCapacity"],
        // {"debug": true},
        ["common", 0.008],
        ["rightSideKneeling", 0.008],
    ],
    "airbagBeamSoundData":[
        ["groupName", "soundIncrease", "soundDecrease", "volumeIncrease", "volumeDecrease", "node:"],
        {"flowRateVolumeFactor": 500},
        {"startFlowRateThreshold": 0.003, "stopFlowRateThreshold": 0.0001},
        ["leftAxle", "event:>Vehicle>Pneumatics>Suspension_Up", "event:>Vehicle>Pneumatics>Suspension_Down", 1, 1, "ab1l"],
        ["rightAxle", "event:>Vehicle>Pneumatics>Suspension_Up", "event:>Vehicle>Pneumatics>Suspension_Down", 1, 1, "ab1r"],
    ],
    "doors": {
        "airTankName": "auxAirTank",
        "supplyHoseRadius": 0.0125,
        "virtualBufferCapacity": 0.002,
        "pressureDumpFlowRate": 0.005,
        "maxSupplyPressurePSI": 50,
        "pressuredBeams":"doorBeamData",
        "crossFlowGroups": "doorCrossFlow",
        "groupSounds": "doorBeamSoundData",
    },
    "doorBeamData": [
        ["beamName", "groupName"],
    ],
    "doorCrossFlow": [
        ["crossFlowTag", "virtualBufferCapacity"],
        ["frontDoors", 0.005],
        ["rearDoors", 0.005],
    ],
    "doorBeamSoundData":[
        ["groupName", "soundIncrease", "soundDecrease", "volumeIncrease", "volumeDecrease", "node:"],
        {"flowRateVolumeFactor": 150}, // scaling of volume RTPC - defines how rapidly volume decreases from max value to 0
        {"startFlowRateThresholdPressureIncrease": 0.0015, "stopFlowRateThresholdPressureIncrease": 0.0015}, // start and stop threshold for door closing
        {"startFlowRateThresholdPressureDecrease": 0.0015, "stopFlowRateThresholdPressureDecrease": 0.0015}, // start and stop threshold for door opening
        ["frontDoors", "event:>Vehicle>Pneumatics>Door_Close", "event:>Vehicle>Pneumatics>Door_Open", 1, 1, "st3rr"], // max volume for opening (front)
        ["rearDoors", "event:>Vehicle>Pneumatics>Door_Close", "event:>Vehicle>Pneumatics>Door_Open", 1, 1, "st11rr"], // max volume for opening (rear)
    ],
    "reverseWarn": {
        "soundNode:": ["ac1r"],
    },
},
