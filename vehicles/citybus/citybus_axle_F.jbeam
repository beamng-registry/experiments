        {"beamDeform":200000,"beamStrength":2525000},
        ["fax4", "fm3l", {"dampCutoffHz":500}],
        ["fax4", "fm3r", {"dampCutoffHz":500}],

        ["fax8l", "fx1l", {"dampCutoffHz":500}],
        ["fax8r", "fx1r", {"dampCutoffHz":500}],

        //linkmounts
        {"beamSpring":40001000,"beamDamp":1000},
        {"beamDeform":75000,"beamStrength":"FLT_MAX"},
