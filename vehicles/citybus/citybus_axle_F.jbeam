        ["fax4l", "fax5l"],
        ["fax4l", "fax6l"],
        ["fax3l", "fax5l"],
        ["fax3l", "fax6l"],
        //R
        ["fax4r", "fax5r"],
        ["fax4r", "fax6r"],
        ["fax3r", "fax5r"],
        ["fax3r", "fax6r"],

