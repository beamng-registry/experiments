        ["fw1r","fax4r"],
        ["fw1r","fax5r"],
        ["fw1r","fax6r"],
        ["fw1rr","fax3r"],
        ["fw1rr","fax4r"],
        ["fw1rr","fax5r"],
        ["fw1rr","fax6r"],
        {"breakGroup":""},
        {"optional":false},

        //suspension links
