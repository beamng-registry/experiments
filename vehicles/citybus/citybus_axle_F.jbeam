"citybus_steering_F": {
    "information":{
        "authors":"BeamNG",
        "name":"Front Steering",
        "value":1200,
    },
    "slotType" : "citybus_steering_F",
    "slots": [
        ["type", "default", "description"],
        ["citybus_power_steering","", "Power Steering"],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["citybus_tierod", ["citybus_tierod_F"]],
        ["citybus_steeringarm_b", ["citybus_steeringarm_b"]],//problem
        ["citybus_steeringarm_a", ["citybus_steeringarm_a"]],//side
    ],
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$toe_F", "range", "", "Wheel Alignment", 1.001, 0.98, 1.02, "Toe Adjust", "Adjusts the wheel toe-in angle", {"subCategory":"Front"}],
        ["$steer_center_F", "range", "", "Wheel Alignment", 0.000, -0.02, 0.02, "Toe Left/Right Trim", "Fine tunes the centerpoint of the steering", {"subCategory":"Front"}],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        //--STEERING--
        {"selfCollision":true},
        {"collision":true},
        {"frictionCoef":0.5},
        {"nodeMaterial":"|NM_METAL"},
        //steering box
        {"nodeWeight":20},
        {"group":["citybus_steeringarm_a"]},
        {"selfCollision":false},
        ["fx3l", 0.96, -4.94, 0.64],
        ["fx4l", 0.96, -4.94, 0.34],
        ["fx5l", 0.81, -5.35, 0.565, {"group":""}],
        {"nodeWeight":30},
        {"group":["citybus_steeringarm_b","citybus_steeringarm_a"]},
        ["fax9l", 0.71, -4.92, 0.565, {"selfCollision":false}],
        ["fax19l",0.71, -4.92, 0.410, {"selfCollision":false,"nodeWeight":10}],
        //steering arm
        {"group":["citybus_steeringarm_b"]},
        ["fax17l", 0.75, -4.10, 0.48,{"nodeWeight":10}],
        {"group":["citybus_steeringarm_c","citybus_steeringarm_b"]},
        ["fax7l", 0.75, -4.10, 0.53],
        {"group":""},
    ],
    "torsionbars": [
        ["id1:", "id2:", "id3:", "id4:"],
        //rigidify frame in bending
        {"spring":4000, "damp":10, "deform":45000, "strength":2500000},
        ["fx3l", "fx4l", "fax9l", "fax19l"],
        ["fax19l", "fax9l", "fax7l", "fax17l"],
    ],
    "beams":[
        ["id1:", "id2:"],
        //--STEERING--
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":90001000,"beamDamp":2000},
        {"beamDeform":150000,"beamStrength":875000},
        //steering link
        ["fax9l", "fax7l", {"beamPrecompression":"$=1+$steer_center_F-0.0027","beamPrecompressionTime":0.5}],
        ["fax9l", "fax17l", {"beamSpring":800100,"beamDamp":500,"beamPrecompression":"$=1+$steer_center_F-0.0027","beamPrecompressionTime":0.5}],
        //tie rod
        ["fax5l", "fax5r", {"beamPrecompression":"$toe_F","beamPrecompressionTime":0.5}],

        //steering damper
        {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1.0, "beamShortBound":1.0},
        {"beamSpring":0,"beamDeform":50000,"beamStrength":100000},
        {"beamLimitSpring":0,"beamLimitDamp":0},
