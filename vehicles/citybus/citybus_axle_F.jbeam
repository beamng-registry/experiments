        ["fx1r", "fm3r"],
        ["fx1r", "fm4r"],
        ["fx1r", "fm5r"],
        ["fx1r", "fm3l"],
        ["fx1r", "fm4l"],
        ["fx1r", "fm5l"],

        //airbag top flexbody helper
        {"beamSpring":10001000,"beamDamp":500},
        {"beamDeform":75000,"beamStrength":"FLT_MAX"},
        //L
        ["fab1l", "fs17l"],
        ["fab1l", "fs18l"],
        ["fab1l", "fm3l"],
        ["fab1l", "fm5l"],
        ["fab1l", "fm4l"],
        ["fab1l", "fm5r"],
        ["fab1l", "fm3r"],
        //R
        ["fab1r", "fs17r"],
        ["fab1r", "fs18r"],
        ["fab1r", "fm3r"],
        ["fab1r", "fm5r"],
        ["fab1r", "fm4r"],
        ["fab1r", "fm5l"],
        ["fab1r", "fm3l"],

        //shock bottom flexbody helper
        {"beamSpring":2501000,"beamDamp":250},
        {"beamDeform":25000,"beamStrength":"FLT_MAX"},
        //L
        ["faxshl", "fax4l"],
        ["faxshl", "fax3l"],
        ["faxshl", "fax8l"],
        ["faxshl", "fax2"],
        ["faxshl", "fax1"],
        //R
        ["faxshr", "fax4r"],
        ["faxshr", "fax3r"],
        ["faxshr", "fax8r"],
        ["faxshr", "fax2"],
        ["faxshr", "fax1"],

        //axle articulation hard limit
        {"beamType":"|SUPPORT", "beamLongBound":4},
        {"beamSpring":10001000,"beamDamp":1000},
        {"beamDeform":250000,"beamStrength":850000},
        {"beamPrecompression":0.88},
        ["fax4l", "fs17l"],
        ["fax4l", "fs18l"],
        ["fax4r", "fs17r"],
        ["fax4r", "fs18r"],
        {"beamPrecompression":1},

        //steering hard limit
        {"beamPrecompression":0.71},
        ["fax5l", "fax2"],
        ["fax5r", "fax2"],
        {"beamPrecompression":0.87},
        ["fax6l", "fax1"],
        ["fax6r", "fax1"],
        {"beamPrecompression":1},

        //crash limiters
        {"beamType":"|SUPPORT", "beamLongBound":2},
        {"beamSpring":5001000,"beamDamp":500},
        {"beamPrecompression":0.85},
        ["fax4l", "fm5r"],
        ["fax4l", "fm3r"],
        ["fax4r", "fm5l"],
        ["fax4r", "fm3l"],

        //--AXLE TO FRAME DAMP--
        {"beamPrecompression":1.0, "beamType":"|BOUNDED", "beamLongBound":1, "beamShortBound":1},
        {"beamSpring":0,"beamDamp":15000,"beamDeform":200000,"beamStrength":350000},
        {"beamLimitSpring":0,"beamLimitDamp":0},
