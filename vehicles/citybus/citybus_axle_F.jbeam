        ["fax7l", "fax4l"],
        ["fax7l", "fax5l"],
        ["fax7l", "fax6l"],

        //stabilise upper link mount
        {"beamSpring":25001000,"beamDamp":500},
        ["fax8l", "fax3l"],
        ["fax8r", "fax3r"],
        ["fax2", "fax8l"],
        ["fax1", "fax8l"],
        ["fax2", "fax8r"],
        ["fax1", "fax8r"],

        //front wheel to axle
        {"beamSpring":40001000,"beamDamp":500},
        {"beamDeform":150000,"beamStrength":1500000},
        //L
        {"optional":true},
        {"breakGroup":"wheel_FL"},
        ["fw1l","fax3l", {"name":"axle_FL"}],
        ["fw1l","fax4l"],
        ["fw1l","fax5l"],
        ["fw1l","fax6l"],
        ["fw1l","fax7l"],
