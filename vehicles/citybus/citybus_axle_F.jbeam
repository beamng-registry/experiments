"citybus_wheeldata_F": {
    "information":{
        "authors":"BeamNG",
        "name":"Front Spindles",
        "value":0,
    },
    "slotType" : "citybus_wheeldata_F",
    "pressureWheels": [
        ["name","hubGroup","group","node1:","node2:","nodeS","nodeArm:","wheelDir"],
        //front wheels definition
        {"selfCollision":true},
        {"collision":true},
        {"triangleCollision":false},
        {"axleBeams":["axle_FL"]},
        ["FL", "wheel_FL", "tire_FL", "fw1ll", "fw1l", 9999, "fax6l", -1, {"torqueCoupling:":"fax1", "torqueArm:":"fax2", "steerAxisUp:":"fax3l","steerAxisDown:":"fax4l"}],
        {"axleBeams":["axle_FR"]},
        ["FR", "wheel_FR", "tire_FR", "fw1rr", "fw1r", 9999, "fax6r", 1, {"torqueCoupling:":"fax1", "torqueArm:":"fax2", "steerAxisUp:":"fax3r","steerAxisDown:":"fax4r"}],
        {"brakeTorque":0},
        {"parkingTorque":0},
        {"triangleCollision":false},
        {"selfCollision":true},
        {"axleBeams":[]},{"disableMeshBreaking":false,"disableTriangleBreaking":false},
        {"enableHubcaps":false},
        {"enableTireLbeams":false},
        {"enableTreadReinfBeams":false},
        {"enableTireReinfBeams":false},
        {"enableTreadReinfBeams":false},
    ],
    "powertrain" : [
        ["type", "name", "inputName", "inputIndex"],
        //front left axle
        ["shaft", "wheelaxle_FL", "differential_F", 1, {"connectedWheel":"FL", "breakTriggerBeam":"axle_FL", "uiName":"Front Left Axle", "friction":10.6, "dynamicFriction": 0.012}],
        //front right axle
        ["shaft", "wheelaxle_FR", "differential_F", 2, {"connectedWheel":"FR", "breakTriggerBeam":"axle_FR", "uiName":"Front Right Axle", "friction":10.6, "dynamicFriction": 0.012}],
    ],
},
"citybus_airbag_F": {
    "information":{
        "authors":"BeamNG",
        "name":"Front Airbags",
        "value":200,
    },
    "slotType" : "citybus_airbag_F",
    "flexbodies": [
         ["mesh", "[group]:", "nonFlexMaterials"],
         {"deformGroup":"airbag_F_break", "deformMaterialBase":"citybus", "deformMaterialDamaged":"invis"},
         ["citybus_airbag_F", ["citybus_airbag_F"]],
         {"deformGroup":"", "deformMaterialBase":"", "deformMaterialDamaged":""},
    ],
    "airbagBeamData": [
            ["beamName", "groupName"],
            ["airbag_FL", "leftAxle"],
            ["airbag_FR", "rightAxle"],
    ],
    "beams": [
        ["id1:", "id2:"],
        //--PRESSURED BEAM AIRBAGS--
        {"beamPrecompression":1, "beamType":"|PRESSURED"},
        {"beamSpring":100,"beamDamp":0,"beamDeform":100000,"beamStrength":250000},
        {"beamLimitSpring":0,"beamLimitDamp":0},
        {"breakGroup":"airbag_F_break"},
        {"breakGroupType":1},
        ["fax8l","fab1l", {"pressurePSI":60,"surface":0.05,"volumeCoef":1, "pressureLimitPSI":300,"name":"airbag_FL","soundFile":"event:>Vehicle>Suspension>bus_01>spring_compress_01","colorFactor":0.5,"attackFactor":10,"volumeFactor":1.6,"decayFactor":2.0,"noiseFactor":0.01,"pitchFactor":0.5,"maxStress":10}],
        ["fax8r","fab1r", {"pressurePSI":60,"surface":0.05,"volumeCoef":1, "pressureLimitPSI":300,"name":"airbag_FR","soundFile":"event:>Vehicle>Suspension>bus_01>spring_compress_01","colorFactor":0.5,"attackFactor":10,"volumeFactor":1.6,"decayFactor":2.0,"noiseFactor":0.01,"pitchFactor":0.5,"maxStress":10}],
        {"breakGroupType":0},
        //--LIMITERS--
        {"beamPrecompression":1, "beamType":"|BOUNDED", "beamLongBound":0.1, "beamShortBound":0.1},
        {"beamSpring":100,"beamDamp":0,"beamDeform":100000,"beamStrength":250000},
        {"beamLimitSpring":50001000,"beamLimitDamp":10000},
        {"deformGroup":"airbag_F_break","deformationTriggerRatio":0.1},
        ["fax4l","fs17l"],
        ["fax4l","fs18l"],
        ["fax4r","fs17r"],
        ["fax4r","fs18r"],
        {"deformGroup":"", "deformationTriggerRatio":""},
        {"breakGroup":""},
        {"beamPrecompression":1, "beamType":"|NORMAL", "beamLongBound":1, "beamShortBound":1},
    ],
},
