{
"citybus_axle_F": {
    "information":{
        "authors":"BeamNG",
        "name":"Front Axle",
        "value":1200,
    },
    "slotType" : "citybus_axle_F",
    "slots": [
        ["type", "default", "description"],
        ["citybus_brake_F","citybus_brake_F","Front Brakes"],
        ["citybus_wheel_F","citybus_wheel_F", "Front Wheels"],
        ["citybus_wheeldata_F","citybus_wheeldata_F", "Front Spindles", {"coreSlot":true}],
        ["citybus_shock_F","citybus_shock_F","Front Shocks"],
        ["citybus_airbag_F","citybus_airbag_F","Front Airbags"],
        ["citybus_steering_F","citybus_steering_F","Front Steering"],
        ["citybus_swaybar_F","citybus_swaybar_F","Front Sway Bar"],
    ],
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        ["citybus_axle_F", ["citybus_axle_F"]],
        ["citybus_hub_F", ["citybus_hub_F","citybus_tierod_F","wheelhub_FL","wheelhub_FR"]],
        ["citybus_lowerarm_F", ["citybus_lowerarm_F"]],
        ["citybus_upperarm_F", ["citybus_upperarm_F"]],
        ["citybus_steeringarm_c", ["citybus_hub_F","citybus_steeringarm_c"]],
    ],
    "nodes": [
        ["id", "posX", "posY", "posZ"],
        //--FRONT AXLE--
        {"frictionCoef":0.5},
        {"nodeMaterial":"|NM_METAL"},
        {"collision":false},
        {"selfCollision":false},
        {"nodeWeight":30},
        {"group":"citybus_axle_F"},
        ["fax1", 0.0, -3.725, 0.444],
        ["fax2", 0.0, -4.505, 0.444],
        ["fax3", 0.0, -4.1, 0.62],

        {"collision":true},
        {"selfCollision":true},
        {"group":["citybus_axle_F","citybus_lowerarm_F","citybus_swaybar"]},
        ["fax4", 0.0, -4.1, 0.191],

        {"group":["citybus_hub_F","citybus_axle_F"]},
        ["fax3l", 0.955, -4.08, 0.62, {"group":["citybus_hub_F","citybus_axle_F","citybus_steeringarm_c"]}],
        ["fax3r", -0.955, -4.08, 0.62],
        ["fax4l", 0.965, -4.10, 0.19, {"group":["citybus_hub_F","citybus_axle_F","citybus_steeringarm_c","citybus_swaybar"]}],
        ["fax4r", -0.965, -4.10, 0.19, {"group":["citybus_hub_F","citybus_axle_F","citybus_swaybar"]}],

        {"group":["citybus_tierod_F","citybus_hub_F"]},
        ["fax5l", 0.91, -3.65, 0.18],
        ["fax5r", -0.91, -3.65, 0.18],
        ["fax6l", 1.1, -4.34541, 0.461],
        ["fax6r", -1.1, -4.34541, 0.461],

        //steering arm
        {"group":["citybus_steeringarm_c","citybus_steeringarm_b"]},
        ["fax7l", 0.70, -4.135, 0.53],

        //shock bottom flexbody
        {"group":"citybus_shock_F"},
        ["faxshl",  0.62, -3.96, 0.42],
        ["faxshr", -0.62, -3.96, 0.42],

        //upper link
        {"selfCollision":true},
        {"nodeWeight":30},
        {"group":["citybus_axle_F","citybus_upperarm_F","citybus_airbag_F"]},
        ["fax8l",  0.62, -4.09, 0.62],
        ["fax8r", -0.62, -4.09, 0.62],

        //upper link mount
        {"selfCollision":false},
        {"group":"citybus_upperarm_F"},
        ["fx1l",  0.62, -4.6, 0.62],
        ["fx1r", -0.62, -4.6, 0.62],

        //upper airbag mount (flexbody helper)
        {"group":["citybus_airbag_F","citybus_shock_F"]},
        ["fab1l",  0.605, -4.09, 0.86],
        ["fab1r", -0.605, -4.09, 0.86],
        {"group":""},
    ],
    "rails": {
        "faxle_l":{"links:":["fax3l", "fax3"], "looped":false, "capped":true},
        "faxle_r":{"links:":["fax3r", "fax3"], "looped":false, "capped":true},
    },
    "slidenodes": [
        ["id:", "railName", "attached", "fixToRail", "tolerance", "spring", "strength", "capStrength"],
