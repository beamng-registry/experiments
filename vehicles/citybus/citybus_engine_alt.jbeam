"citybus_turbo_400": {
    "information":{
        "authors":"BeamNG",
        "name":"T400 Turbocharger",
        "value":6000,
    },
    "slotType" : "citybus_turbo",
    "flexbodies": [
        ["mesh", "[group]:"],
    ],
    "turbocharger": {
        "hissLoopEvent":"event:>Vehicle>Forced_Induction>turbo_bus_01>turbo_hiss",
        "whineLoopEvent":"event:>Vehicle>Forced_Induction>turbo_bus_01>turbo_spin",
        "bovEnabled":false,
        "bovSoundVolumeCoef": 0.0,
        "hissVolumePerPSI": 0.02,
        "whineVolumePer10kRPM": 0.05,
        "whinePitchPer10kRPM": 0.165,
        "wastegateStart":9,
        "wastegateLimit":11,
        "maxExhaustPower": 750,
        "backPressureCoef": 0.000005,
        "frictionCoef": 2.5,
        "inertia":1,
        "damageThresholdTemperature": 750,
        "pressurePSI":[
            //turbineRPM, pressure(PSI)
            [0,         0],
            [15000,     0],
            [30000,     5],
            [60000,     13],
            [90000,     36],
            [120000,    45],
            [150000,    65],
            [200000,    85],
        ],
        "engineDef":[
            //engineRPM, efficiency, exhaustFactor
            [0,     0.20,   0.10],
            [250,   0.20,   0.10],
            [500,   0.60,   0.40],
            [800,   0.80,   0.90],
            [1000,  0.90,   0.90],
            [1200,  0.90,   0.90],
            [1400,  0.90,   0.90],
            [1600,  0.86,   0.85],
            [2000,  0.85,   0.85],
            [2500,  0.80,   0.85],
            [3000,  0.80,   0.85],
            [3500,  0.80,   0.85],
        ],
    },
    "mainEngine": {
        //turbocharger name
        "turbocharger":"turbocharger",
        "$+particulates":0.1,
        //turbocharger deform groups
        "deformGroups_turbo":["mainEngine_turbo","mainEngine_intercooler","mainEngine_piping"]
    },
},
