        {"axleBeams":["axle_RR1"]},
        ["RR1", "wheel_RR", "tire_RR", "rw1rr", "rw1r", 9999, "ax3r", 1, {"torqueCoupling:":"ax1r", "torqueArm:":"ax2r"}],
