        ["differential", "differential_RR", "differential_R", 2, {"diffType":"dually", "gearRatio":1, "lockTorque":2000000, "friction":16.6, "dynamicFriction": 0.027, "uiName":"Rear Right Dually Hub","defaultVirtualInertia":2}],
